# Copy this file to .env for local development. On your host (Railway, Render, etc.)
# set these as environment variables instead. Only the first block is required.

# --- Required in production ---
# The public address of your site (used in emails and payment links).
APP_URL=https://your-domain.com
# Your first admin login. Created automatically on start-up if it doesn't exist.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-something-long

# Where the database and uploaded images are stored. Point this at a persistent disk/volume.
DATA_DIR=./data
PORT=3000
NODE_ENV=production

# --- Optional: these can all be entered in Admin → Settings instead ---
# Square (https://developer.squareup.com/apps → your app → Credentials / Locations)
# SQUARE_ENVIRONMENT=sandbox
# SQUARE_APPLICATION_ID=
# SQUARE_LOCATION_ID=
# SQUARE_ACCESS_TOKEN=

# Email — any SMTP provider (Gmail app password, Resend, Brevo, Mailgun…)
# SMTP_URL=smtps://user:password@smtp.example.com:465
# SMTP_FROM="InkSpace <bookings@your-domain.com>"
