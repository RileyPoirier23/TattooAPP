# Copy this file to .env for local development. On your host (Railway, Render, etc.)
# set these as environment variables instead. Only the first block is required.

# --- Required in production ---
# The public address of your site (used in emails and payment links).
APP_URL=https://your-domain.com
# Your first admin login. Created automatically on start-up if it doesn't exist.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-something-long

# Where the database and uploaded images are stored. The Docker image already uses /data —
# only set this when running without Docker (e.g. DATA_DIR=./data on your own computer).
# DATA_DIR=./data
# PORT=3000

# --- Optional: these can all be entered in Admin → Settings instead ---
# Square (https://developer.squareup.com/apps → your app → Credentials / Locations)
# SQUARE_ENVIRONMENT=sandbox
# SQUARE_APPLICATION_ID=
# SQUARE_LOCATION_ID=
# SQUARE_ACCESS_TOKEN=

# Email — Resend (works everywhere, including Railway's Hobby plan) or any SMTP provider.
# Railway only allows SMTP on its Pro plan, so use Resend there.
# RESEND_API_KEY=re_...
# SMTP_URL=smtps://user:password@smtp.example.com:465
# SMTP_FROM="InkSpace <bookings@your-domain.com>"

# Forgot the admin password? Set this to true, set ADMIN_PASSWORD, redeploy once, then remove it.
# ADMIN_RESET_PASSWORD=true
